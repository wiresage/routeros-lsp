{
:local a 10
:local b 3
:put ($a + $b)
:put ($a - $b)
:put ($a * $b)
:put ($a / $b)
:put ($a % $b)
:put ($a > $b)
:put ($a <= $b)
:put ($a != $b)
:put ($a = 10 and $b = 3)
:put ($a = 10 && !($b = 3))
:put ($a = 1 or $b = 3)
:put ($a = 1 || $b = 1)
:put (1 << 4)
:put (256 >> 2)
:put (6 & 3)
:put (6 | 3)
:put (6 ^ 3)
:put ("abc" . "def")
:put ("abc" ~ "^a")
:put (192.168.1.1 & 255.255.255.0)
:put (-$a)
:put (!true)
:put ([:len "abc"] * 2)
}
